[Unit]
Description=B2B Teklif Sistemi (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/teklif-sistemi
ExecStart=/opt/teklif-sistemi/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8501 --workers 2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=SECRET_KEY=change-this-to-random-64-char-string-in-production
Environment=ADMIN_EMAIL=admin@example.com
Environment=ADMIN_PASS=Admin123!
Environment=ADMIN_COMPANY=B2B Sistem

[Install]
WantedBy=multi-user.target
